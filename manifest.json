{
  "manifest_version": 3,
  "name": "Docs Font Presets",
  "version": "1.1.0",
  "description": "Switch between saved font presets (family, size, color, bold/italic/underline) while typing in Google Docs.",
  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://docs.google.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Docs Font Presets"
  },
  "content_scripts": [
    {
      "matches": [
        "https://docs.google.com/document/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://docs.google.com/document/*"
      ],
      "js": [
        "page-keys.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "commands": {
    "preset-1": {
      "suggested_key": {
        "default": "Alt+Shift+1"
      },
      "description": "Apply preset 1"
    },
    "preset-2": {
      "suggested_key": {
        "default": "Alt+Shift+2"
      },
      "description": "Apply preset 2"
    },
    "preset-3": {
      "suggested_key": {
        "default": "Alt+Shift+3"
      },
      "description": "Apply preset 3"
    },
    "next-preset": {
      "suggested_key": {
        "default": "Alt+Shift+N"
      },
      "description": "Cycle to the next preset"
    },
    "preset-4": {
      "description": "Apply preset 4"
    },
    "preset-5": {
      "description": "Apply preset 5"
    },
    "preset-6": {
      "description": "Apply preset 6"
    },
    "preset-7": {
      "description": "Apply preset 7"
    },
    "preset-8": {
      "description": "Apply preset 8"
    },
    "preset-9": {
      "description": "Apply preset 9"
    }
  }
}
